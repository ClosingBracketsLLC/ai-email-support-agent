DATABASE_URL=postgres://aesa:aesa@localhost:5434/aesa_dev
PORT=3001
LOG_LEVEL=info
# Public origin of this api (Better Auth baseURL; OAuth redirect URIs are <APP_BASE_URL>/api/auth/callback/<provider>;
# it is also where the one-click review pages /a/<draftId>?t=<token> are served). MUST be the IDENTICAL
# value in apps/worker/.env, which builds the digest email's Approve links from it.
APP_BASE_URL=http://localhost:3001
# Origin the Expo web app is served from (CORS, trusted origin, invitation links). Expo dev server = 8081.
# MUST be the IDENTICAL value in apps/worker/.env, which builds the digest email's "open the ticket" links from it.
APP_WEB_ORIGIN=http://localhost:8081
# `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# false (default) | true (trust one hop's x-forwarded-for) | a comma-separated proxy IP/CIDR list; required in production if AUTH_RATE_LIMIT=on
TRUST_PROXY=false
# Global per-IP request cap across the whole api (not only /api/auth/*), requests/minute. 0 disables it.
API_RATE_LIMIT_PER_MINUTE=300
# Optional social sign-in; leave blank to hide the buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Platform mail. devsink (default outside production): codes are readable at GET /__dev/mail/latest?to=<email>.
# All three now matter in BOTH apps — apps/worker sends the daily digest email through the same
# @aesa/platform-mail transport under its `cron` role — and MAIL_FROM MUST be the IDENTICAL address in
# apps/api/.env and apps/worker/.env (the worker's sync walk keys its platform-mail skip off it, and
# this app keys its verification-code interception off it; nothing checks the two agree at boot).
EMAIL_TRANSPORT=devsink
RESEND_API_KEY=
MAIL_FROM=
# Mailbox OAuth (Gmail/Microsoft Graph mail access for the connect flow) — distinct from GOOGLE_/MICROSOFT_
# CLIENT_ID above, which are Better Auth's SSO login providers. Redirect URI: <APP_BASE_URL>/connect/<gmail|microsoft>/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# Gmail Pub/Sub push webhook (Task 18); optional until that task lands
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SA_EMAIL=
# Object storage for knowledge uploads — minio locally (`pnpm db:up` starts it, `pnpm s3:init` creates
# the bucket), S3/R2 in production. All six or none: a half-configured set throws at boot. REQUIRED IN
# PRODUCTION (the presigned PUT the Knowledge screen's file upload issues has nowhere else to point);
# in dev/test a missing set falls back to an in-memory store with one warning — without minio the web
# upload flow will not work locally. The worker reads the SAME six names for its own upload reads —
# point both apps at one bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aesa-dev
S3_ACCESS_KEY_ID=aesa
S3_SECRET_ACCESS_KEY=aesaaesa
S3_FORCE_PATH_STYLE=true
