DATABASE_URL=postgres://aesa:aesa@localhost:5434/aesa_dev
WORKER_ROLES=sync,agent,send,knowledge,cron
# The KEK ring: base64 of 32 random bytes: `openssl rand -base64 32`. Required in production when
# WORKER_ROLES includes `sync` (mailbox.sync), `send` (send.execute) or `agent` (a tenant's BYOK
# provider key is opened under that org's DEK on every model call, and llm.probe re-wraps a freshly
# sealed one) — those credentials are sealed under it and there is no other way to reach a provider.
# It must be the SAME ring on every replica: a key sealed under ring A cannot be opened by a replica
# holding ring B, and the only symptom is `provider_unavailable`. In dev/test a missing ring skips
# those roles' registrations (for `agent`, just llm.probe) and logs a warning.
AESA_KEK_V1=
AESA_KEK_ACTIVE=1
# The platform's MANAGED model key. Required in production when WORKER_ROLES includes `agent`
# (ticket.triage, ticket.draft, agent.sandbox, guidance.suggest, llm.probe, memory.capture). Since
# Phase 6 a missing key outside production no longer skips the agent role: every job still registers
# with `managed = null`, so BYOK agents work normally and an agent configured for Managed AI lands
# `provider_unavailable`. llm.probe is gated by the KEK ring ALONE, so a ringed dev box with no
# Anthropic key can still add, probe and re-wrap BYOK credentials.
# Pair it with an Anthropic Console workspace spend limit: the in-product caps are per-org, and the
# daily USD cap covers MANAGED spend only — a BYOK tenant's own spend is capped at their provider.
ANTHROPIC_API_KEY=
# All-or-none pairs (set both or neither); a deployment that only supports one provider leaves the
# other pair blank. A connection can only use a provider whose pair is set — token refresh has no
# other path. At least one pair is REQUIRED IN PRODUCTION when WORKER_ROLES includes `send`:
# maybeRegisterSendRole (apps/worker/src/send-role.ts) refuses to boot without one, because a send
# replica that cannot refresh a token looks healthy while every approved reply silently fails.
# `sync` is NOT gated on a pair at boot (loadConfig checks only the KEK ring and MAIL_FROM for it),
# so a `sync` replica without one starts and then throws inside mailbox.sync / renew-watch /
# revoke at the first refresh — set a pair on any replica that runs `sync` too.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# projects/<project>/topics/<topic> — absent means mailbox.renew-watch never subscribes a Gmail
# connection to push; mailbox.poll-sweep's cadence still keeps it synced.
GMAIL_PUBSUB_TOPIC=
# https origin of the api — absent means mailbox.renew-watch never creates a Graph subscription.
# Graph notifications land on `${WEBHOOK_PUBLIC_URL}/webhooks/microsoft`.
WEBHOOK_PUBLIC_URL=
# MUST be the IDENTICAL address in apps/api/.env (each app reads only its own .env, and nothing checks
# this at boot — drift fails silently in both directions). Two jobs read it: mailbox.sync compares an
# inbound message's From against it to recognize the platform's own mail (sign-in codes, invitations,
# address-verification codes) and keep it out of the customer ticket queue, and notify.digest's daily
# digest email SENDS from it. Required in production when WORKER_ROLES includes `sync` (mailbox.sync)
# or `cron` with EMAIL_TRANSPORT=resend (the digest email); in dev/test a missing value just skips
# mailbox.sync registration and leaves the digest on the devsink's default sender.
MAIL_FROM=
# Platform mail for notify.digest's daily digest email — the same three variables the api reads (and
# MAIL_FROM above must be the SAME address in both). devsink (the default outside production) drops the
# mail into memory; production with WORKER_ROLES including `cron` requires resend + RESEND_API_KEY + MAIL_FROM.
# A production replica WITHOUT the `cron` role sends no platform mail and needs none of this.
EMAIL_TRANSPORT=devsink
RESEND_API_KEY=
# The api's public origin and the Expo web origin — the digest email's link bases
# (`<APP_BASE_URL>/a/<draftId>?t=<token>` to approve, `<APP_WEB_ORIGIN>/ticket/<id>` to open).
# Both must be set or the digest email pass stays off (the push digest still runs), and both MUST be
# the IDENTICAL values in apps/api/.env — nothing checks it at boot, and drift just points the
# owner's one-click links at an origin that cannot serve them.
APP_BASE_URL=http://localhost:3001
APP_WEB_ORIGIN=http://localhost:8081
# Voyage embeddings (voyageai.com). REQUIRED IN PRODUCTION when WORKER_ROLES includes `knowledge`
# (knowledge.embed-batch writes every chunk's vector) or `agent` (the draft/sandbox retriever embeds
# every query). In dev/test a missing key falls back to the deterministic hash embedder with one
# warning — its vectors are NOT comparable with Voyage's, so a workspace embedded by one and queried
# by the other retrieves nothing from the vector leg (the tsvector leg still answers).
VOYAGE_API_KEY=
# voyage-4 (default) or voyage-4-lite. The value is stored on every chunk as `embedding_model` and is
# part of the vector leg's WHERE, so changing it on a live workspace hides every existing chunk from
# that leg until the re-embed job that is still a carry-over (→ Phase 7) runs.
KNOWLEDGE_EMBED_MODEL=voyage-4
# `on` adds Voyage's cross-encoder rerank pass over the fused retrieval candidates (one more API call
# per retrieval); `off` (the default) skips it. Inert without VOYAGE_API_KEY.
KNOWLEDGE_RERANK=off
# Object storage for knowledge uploads — minio locally (`pnpm db:up` starts it, `pnpm s3:init` creates
# the bucket), S3/R2 in production. All six or none: a half-configured set throws at boot. REQUIRED
# IN PRODUCTION when WORKER_ROLES includes `knowledge` (knowledge.ingest reads each uploaded file's
# bytes from the bucket); in dev/test a missing set falls back to an in-memory store with one warning,
# which serves paste and crawl sources fine and fails every upload with "object missing". The api
# reads the SAME six names for its presigned PUT — point both apps at one bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aesa-dev
S3_ACCESS_KEY_ID=aesa
S3_SECRET_ACCESS_KEY=aesaaesa
S3_FORCE_PATH_STYLE=true

# Read by `pnpm s3:init` ONLY (never by this app): the single origin written into the bucket's CORS
# rule so the browser's cross-origin PUT is allowed. Defaults to http://localhost:8081; set it to
# APP_WEB_ORIGIN before running s3:init against a real bucket, or every upload dies in a preflight.
# (minio has no per-bucket CORS API — locally this is MINIO_API_CORS_ALLOW_ORIGIN in compose.yaml.)
# S3_CORS_ORIGIN=

# Phase 5 (autonomy and learning) adds NO environment variable to either app. Its two knobs are
# per-workspace `org_settings` rows, not env: `notifications.push_auto_sends` (boolean, default
# false — the Hold-button push on every auto-send) and `guidance.daily_suggest_cap` (number,
# default 50 — the per-org daily ceiling on the guidance-suggestion model call).

# Phase 6 (provider choice / BYOK) adds NO environment variable to either app either — the KEK ring
# above was already one; what changed is that `agent` now needs it too (see AESA_KEK_V1). The one
# new runtime dependency is `openai@7.15.0` (pinned, packages/llm only), so a deploy needs
# `pnpm install`. A workspace's own provider key is pasted in Settings → AI, sealed by the api and
# re-wrapped here — it is never an environment variable, on either side.
