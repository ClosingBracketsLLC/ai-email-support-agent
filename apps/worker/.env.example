DATABASE_URL=postgres://aesa:aesa@localhost:5434/aesa_dev
WORKER_ROLES=sync,agent,send,knowledge,cron
# base64 of 32 random bytes: `openssl rand -base64 32`
AESA_KEK_V1=
AESA_KEK_ACTIVE=1
# Required in production when WORKER_ROLES includes `agent` (the ticket.triage job); in dev/test a
# missing key just skips that job's registration and logs a warning.
ANTHROPIC_API_KEY=
# All-or-none pairs (set both or neither); a deployment that only supports one provider leaves the
# other pair blank. Required in production for any mailbox connection using that provider.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# projects/<project>/topics/<topic> — absent means mailbox.renew-watch never subscribes a Gmail
# connection to push; mailbox.poll-sweep's cadence still keeps it synced.
GMAIL_PUBSUB_TOPIC=
# https origin of the api — absent means mailbox.renew-watch never creates a Graph subscription.
# Graph notifications land on `${WEBHOOK_PUBLIC_URL}/webhooks/microsoft`.
WEBHOOK_PUBLIC_URL=
# MUST equal apps/api/.env's MAIL_FROM (each app reads only its own .env). Two jobs read it: mailbox.sync
# compares an inbound message's From against it to recognize the platform's own mail (sign-in codes,
# invitations, address-verification codes) and keep it out of the customer ticket queue, and notify.digest's
# daily digest email SENDS from it. Required in production when WORKER_ROLES includes `sync` (mailbox.sync)
# or `cron` with EMAIL_TRANSPORT=resend (the digest email); in dev/test a missing value just skips
# mailbox.sync registration and leaves the digest on the devsink's default sender.
MAIL_FROM=
# Platform mail for notify.digest's daily digest email — the same three variables the api reads (and
# MAIL_FROM above must be the SAME address in both). devsink (the default outside production) drops the
# mail into memory; production with WORKER_ROLES including `cron` requires resend + RESEND_API_KEY + MAIL_FROM.
# A production replica WITHOUT the `cron` role sends no platform mail and needs none of this.
EMAIL_TRANSPORT=devsink
RESEND_API_KEY=
# The api's public origin and the Expo web origin — the digest email's link bases
# (`<APP_BASE_URL>/a/<draftId>?t=<token>` to approve, `<APP_WEB_ORIGIN>/ticket/<id>` to open).
# Both must be set or the digest email pass stays off (the push digest still runs).
APP_BASE_URL=http://localhost:3001
APP_WEB_ORIGIN=http://localhost:8081
