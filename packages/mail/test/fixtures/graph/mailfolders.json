{
  "request": {
    "method": "GET",
    "path": "/v1.0/me/mailFolders",
    "query": { "$select": "id,displayName" }
  },
  "response": {
    "status": 200,
    "body": {
      "value": [
        { "id": "folder-inbox-id", "displayName": "Inbox" },
        { "id": "folder-sent-id", "displayName": "Sent Items" },
        { "id": "folder-junk-id", "displayName": "Junk Email" },
        { "id": "folder-other-id", "displayName": "Random Custom Folder" }
      ]
    }
  }
}
